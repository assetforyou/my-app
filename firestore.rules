rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail(emailField) {
      return isSignedIn()
        && emailField is string
        && request.auth.token.email == emailField;
    }

    function createsWithOwnEmail() {
      return isSignedIn()
        && request.resource.data.userEmail is string
        && request.auth.token.email == request.resource.data.userEmail;
    }

    match /autos/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /cash/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /crypto/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /customAssets/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /customAssetItems/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /loans/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /metals/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /properties/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /stocks/{docId} {
      allow read: if isOwnerEmail(resource.data.userEmail);
      allow create: if createsWithOwnEmail();
      allow update, delete: if isOwnerEmail(resource.data.userEmail);
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
