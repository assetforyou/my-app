# Copy to `.env` and fill in values (`.env` is gitignored).

# --- Optional: live Firestore smoke test (`npm run test:firestore`)
# Use a real Firebase Auth user from this project (not production secrets in CI).
TEST_FIREBASE_EMAIL=
TEST_FIREBASE_PASSWORD=

# Note: `.env.development` sets DANGEROUSLY_DISABLE_HOST_CHECK=true so `npm start`
# works with the `proxy` field in package.json.

# --- Create React App (browser; never put secrets in REACT_APP_*)
# Google AdSense (optional) — display unit from your AdSense account
REACT_APP_ADSENSE_CLIENT_ID=
REACT_APP_ADSENSE_SLOT=

REACT_APP_ALPHA_VANTAGE_API_KEY=
# Optional: inbox for contact form JSON body; otherwise server uses SMTP_TO only
REACT_APP_CONTACT_INBOX=

# --- Mail API: run `npm run server` (or `npm run dev`)
PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
